rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function papel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }
    function ehAdmin()   { return logado() && papel() == 'admin'; }
    function ehMesario() { return logado() && papel() == 'mesario'; }
    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    match /categorias/{id} {
      allow read: if true;
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin()
        || (ehMesario() && soMudou(['tabela', 'finalizada', 'resultadoFinal']));
    }

    match /lutas/{id} {
      allow read: if true;
      allow create: if ehAdmin()
        || (ehMesario() && request.resource.data.tipo == 'mataMata'
            && request.resource.data.status == 'pendente');
      allow update: if ehAdmin()
        || (ehMesario() && soMudou(['vencedor', 'tipoVitoria', 'status', 'proximaLutaId']));
      allow delete: if ehAdmin()
        || (ehMesario() && resource.data.tipo == 'mataMata'
            && resource.data.status == 'pendente');
    }

    match /areas/{id} {
      allow read: if true;
      allow create, delete: if ehAdmin();
      allow update: if ehAdmin() || (ehMesario() && soMudou(['lutas']));
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow write: if ehAdmin();
    }
  }
}
